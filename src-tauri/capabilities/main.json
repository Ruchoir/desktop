{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the launcher may call. It is bundled with the app, which Tauri treats as a local origin.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "opener:allow-open-url",
    "allow-instances-state",
    "allow-instance-add",
    "allow-instance-sign-in",
    "allow-instance-sign-out",
    "allow-instance-remove",
    "allow-product-open",
    "allow-desktop-settings",
    "allow-set-desktop-settings",
    "allow-set-shell-labels",
    "allow-app-quit",
    "allow-about-app",
    "allow-diagnostics",
    "allow-open-log-folder",
    "allow-update-state",
    "allow-update-install"
  ]
}
